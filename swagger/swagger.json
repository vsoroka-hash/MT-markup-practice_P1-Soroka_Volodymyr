{
  "openapi": "3.0.0",
  "info": {
    "title": "Flora API",
    "version": "1.0.0",
    "description": "REST API for Flora bouquet catalogue, reviews and orders"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local server"
    },
    {
      "url": "https://flora-backend-soroka.onrender.com",
      "description": "Render deployment"
    }
  ],
  "tags": [
    {
      "name": "Bouquets",
      "description": "Bouquet catalogue endpoints"
    },
    {
      "name": "Reviews",
      "description": "Customer review endpoints"
    },
    {
      "name": "Orders",
      "description": "Order checkout endpoints"
    }
  ],
  "paths": {
    "/api/bouquets": {
      "get": {
        "tags": ["Bouquets"],
        "summary": "Get bouquets",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": { "type": "integer", "minimum": 1, "default": 1 },
            "description": "Page number"
          },
          {
            "in": "query",
            "name": "limit",
            "schema": { "type": "integer", "minimum": 1, "default": 4 },
            "description": "Page size"
          },
          {
            "in": "query",
            "name": "title",
            "schema": { "type": "string" },
            "description": "Case-insensitive title filter"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated bouquet list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BouquetListResponse" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Bouquets"],
        "summary": "Create bouquet",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BouquetCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created bouquet",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Bouquet" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/bouquets/bestsellers": {
      "get": {
        "tags": ["Bouquets"],
        "summary": "Get bestseller bouquets",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": { "type": "integer", "minimum": 1, "default": 6 }
          }
        ],
        "responses": {
          "200": {
            "description": "Bestseller bouquet list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Bouquet" }
                }
              }
            }
          }
        }
      }
    },
    "/api/bouquets/{id}": {
      "get": {
        "tags": ["Bouquets"],
        "summary": "Get one bouquet by id",
        "parameters": [{ "$ref": "#/components/parameters/BouquetId" }],
        "responses": {
          "200": {
            "description": "Bouquet",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Bouquet" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Bouquets"],
        "summary": "Update bouquet fields",
        "parameters": [{ "$ref": "#/components/parameters/BouquetId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BouquetUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated bouquet",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Bouquet" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Bouquets"],
        "summary": "Delete bouquet",
        "parameters": [{ "$ref": "#/components/parameters/BouquetId" }],
        "responses": {
          "200": {
            "description": "Deleted bouquet",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Bouquet" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/bouquets/{id}/favorite": {
      "patch": {
        "tags": ["Bouquets"],
        "summary": "Update bouquet favorite status",
        "parameters": [{ "$ref": "#/components/parameters/BouquetId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BouquetFavoriteUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated bouquet",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Bouquet" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/bouquets/{id}/photo": {
      "patch": {
        "tags": ["Bouquets"],
        "summary": "Upload bouquet photo",
        "parameters": [{ "$ref": "#/components/parameters/BouquetId" }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["photo"],
                "properties": {
                  "photo": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bouquet with updated photoURL",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Bouquet" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/reviews": {
      "get": {
        "tags": ["Reviews"],
        "summary": "Get customer reviews",
        "responses": {
          "200": {
            "description": "Review list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Review" }
                }
              }
            }
          }
        }
      }
    },
    "/api/orders": {
      "post": {
        "tags": ["Orders"],
        "summary": "Create order",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/OrderCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created order",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Order" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": {
            "description": "Bouquet not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "message": "Bouquet not found" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "BouquetId": {
        "in": "path",
        "name": "id",
        "required": true,
        "schema": { "type": "integer", "minimum": 1 },
        "description": "Bouquet id"
      }
    },
    "schemas": {
      "Bouquet": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "price",
          "favorite",
          "photoURL"
        ],
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120,
            "example": "Peach Meadow"
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000,
            "example": "A soft and radiant arrangement of peach and blush roses."
          },
          "price": {
            "type": "integer",
            "minimum": 1,
            "example": 55
          },
          "favorite": {
            "type": "boolean",
            "example": false
          },
          "photoURL": {
            "type": "string",
            "format": "uri",
            "example": "https://flora-backend-soroka.onrender.com/images/bouquet-1-1x.jpg"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BouquetCreate": {
        "type": "object",
        "required": ["title", "description", "price"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120,
            "example": "Peach Meadow"
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000,
            "example": "A soft and radiant arrangement of peach and blush roses."
          },
          "price": {
            "type": "integer",
            "minimum": 1,
            "example": 55
          },
          "favorite": {
            "type": "boolean",
            "example": false
          },
          "photoURL": {
            "type": "string",
            "format": "uri",
            "example": "https://example.com/photo.jpg"
          }
        }
      },
      "BouquetUpdate": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000
          },
          "price": {
            "type": "integer",
            "minimum": 1
          },
          "favorite": {
            "type": "boolean"
          },
          "photoURL": {
            "type": "string",
            "format": "uri"
          }
        },
        "minProperties": 1
      },
      "BouquetFavoriteUpdate": {
        "type": "object",
        "required": ["favorite"],
        "properties": {
          "favorite": { "type": "boolean", "example": true }
        }
      },
      "BouquetListResponse": {
        "type": "object",
        "required": ["data", "total", "page", "limit", "hasMore"],
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Bouquet" }
          },
          "total": { "type": "integer", "example": 8 },
          "page": { "type": "integer", "example": 1 },
          "limit": { "type": "integer", "example": 4 },
          "hasMore": { "type": "boolean", "example": true }
        }
      },
      "Review": {
        "type": "object",
        "required": ["id", "author", "text"],
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "author": {
            "type": "string",
            "maxLength": 120,
            "example": "Emily R."
          },
          "text": {
            "type": "string",
            "example": "Flora made my anniversary unforgettable with their beautiful bouquet."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Order": {
        "type": "object",
        "required": [
          "id",
          "bouquetId",
          "bouquetTitle",
          "quantity",
          "customerName",
          "phone"
        ],
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "bouquetId": { "type": "integer", "minimum": 1, "example": 1 },
          "bouquetTitle": {
            "type": "string",
            "maxLength": 120,
            "example": "Peach Meadow"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          },
          "customerName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120,
            "example": "Ann Smith"
          },
          "phone": {
            "type": "string",
            "minLength": 5,
            "maxLength": 40,
            "example": "+1 (555) 123-4567"
          },
          "address": {
            "type": "string",
            "nullable": true,
            "maxLength": 240,
            "example": "456 Floral Ave"
          },
          "comment": {
            "type": "string",
            "nullable": true,
            "maxLength": 1000,
            "example": "Please deliver in the morning."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OrderCreate": {
        "type": "object",
        "required": ["bouquetId", "customerName", "phone"],
        "properties": {
          "bouquetId": { "type": "integer", "minimum": 1, "example": 1 },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99,
            "default": 1,
            "example": 1
          },
          "customerName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120,
            "example": "Ann Smith"
          },
          "phone": {
            "type": "string",
            "minLength": 5,
            "maxLength": 40,
            "example": "+1 (555) 123-4567"
          },
          "address": {
            "type": "string",
            "nullable": true,
            "maxLength": 240,
            "example": "456 Floral Ave"
          },
          "comment": {
            "type": "string",
            "nullable": true,
            "maxLength": 1000,
            "example": "Please deliver in the morning."
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": {
            "type": "string",
            "example": "Not found"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Validation error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "message": "Not found" }
          }
        }
      }
    }
  }
}
