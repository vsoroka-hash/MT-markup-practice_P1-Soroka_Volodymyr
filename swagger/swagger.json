{
  "openapi": "3.0.0",
  "info": {
    "title": "Flora Bouquets API",
    "version": "1.0.0",
    "description": "REST API for Flora bouquet catalogue"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local server"
    }
  ],
  "tags": [
    {
      "name": "Bouquets",
      "description": "Bouquet catalogue endpoints"
    }
  ],
  "paths": {
    "/api/bouquets": {
      "get": {
        "tags": ["Bouquets"],
        "summary": "Get all bouquets",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": { "type": "integer", "minimum": 1 },
            "description": "Optional page number"
          },
          {
            "in": "query",
            "name": "limit",
            "schema": { "type": "integer", "minimum": 1 },
            "description": "Optional page size"
          },
          {
            "in": "query",
            "name": "title",
            "schema": { "type": "string" },
            "description": "Optional case-insensitive title filter"
          }
        ],
        "responses": {
          "200": {
            "description": "Bouquet list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Bouquet" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Bouquets"],
        "summary": "Create bouquet",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BouquetCreate" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created bouquet",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Bouquet" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/bouquets/bestsellers": {
      "get": {
        "tags": ["Bouquets"],
        "summary": "Get bestseller bouquets",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": { "type": "integer", "minimum": 1, "default": 6 }
          }
        ],
        "responses": {
          "200": {
            "description": "Bestseller bouquet list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Bouquet" }
                }
              }
            }
          }
        }
      }
    },
    "/api/bouquets/{id}": {
      "get": {
        "tags": ["Bouquets"],
        "summary": "Get one bouquet by id",
        "parameters": [{ "$ref": "#/components/parameters/BouquetId" }],
        "responses": {
          "200": {
            "description": "Bouquet",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Bouquet" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Bouquets"],
        "summary": "Update bouquet fields",
        "parameters": [{ "$ref": "#/components/parameters/BouquetId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BouquetUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated bouquet",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Bouquet" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["Bouquets"],
        "summary": "Delete bouquet",
        "parameters": [{ "$ref": "#/components/parameters/BouquetId" }],
        "responses": {
          "200": {
            "description": "Deleted bouquet",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Bouquet" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/bouquets/{id}/favorite": {
      "patch": {
        "tags": ["Bouquets"],
        "summary": "Update bouquet favorite status",
        "parameters": [{ "$ref": "#/components/parameters/BouquetId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["favorite"],
                "properties": {
                  "favorite": { "type": "boolean", "example": true }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated bouquet",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Bouquet" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/bouquets/{id}/photo": {
      "patch": {
        "tags": ["Bouquets"],
        "summary": "Upload bouquet photo",
        "parameters": [{ "$ref": "#/components/parameters/BouquetId" }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["photo"],
                "properties": {
                  "photo": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bouquet with updated photoURL",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Bouquet" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "BouquetId": {
        "in": "path",
        "name": "id",
        "required": true,
        "schema": { "type": "integer", "minimum": 1 },
        "description": "Bouquet id"
      }
    },
    "schemas": {
      "Bouquet": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "price",
          "favorite",
          "photoURL"
        ],
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120,
            "example": "Peach Meadow"
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000,
            "example": "A soft and radiant arrangement of peach and blush roses."
          },
          "price": {
            "type": "integer",
            "minimum": 1,
            "example": 55
          },
          "favorite": {
            "type": "boolean",
            "example": false
          },
          "photoURL": {
            "type": "string",
            "format": "uri",
            "example": "https://flora-backend-soroka.onrender.com/photos/6cbb6237-63ac-4c3e-aa58-25f781fa99ab.jpg"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BouquetCreate": {
        "type": "object",
        "required": ["title", "description", "price"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120,
            "example": "Peach Meadow"
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000,
            "example": "A soft and radiant arrangement of peach and blush roses."
          },
          "price": {
            "type": "integer",
            "minimum": 1,
            "example": 55
          },
          "favorite": {
            "type": "boolean",
            "example": false
          },
          "photoURL": {
            "type": "string",
            "format": "uri",
            "example": "https://example.com/photo.jpg"
          }
        }
      },
      "BouquetUpdate": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000
          },
          "price": {
            "type": "integer",
            "minimum": 1
          },
          "favorite": {
            "type": "boolean"
          },
          "photoURL": {
            "type": "string",
            "format": "uri"
          }
        },
        "minProperties": 1
      },
      "Error": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": {
            "type": "string",
            "example": "Not found"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Validation error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "message": "Not found" }
          }
        }
      }
    }
  }
}
